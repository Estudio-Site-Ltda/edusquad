# =============================================================
# EduSquad - .gitignore
# =============================================================

# Browser sessions and browser validation artifacts
_edusquad/_browser_profile/
.playwright-cli/

# Local institutional/user memory. Commit only neutral examples.
_edusquad/_memory/*
!_edusquad/_memory/*.example.md

# Local brand manual. Commit only DESIGN.example.md.
DESIGN.md

# Environment variables and credentials
.env
.env.local
.env.*.local
*.env
.envrc

# Squads created locally. Keep the repository placeholder only.
squads/*
!squads/.gitkeep

# Brand assets remain local; all other assets are shared in Git.
assets/branding/*
!assets/branding/.gitkeep

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json

# Dashboard dependencies and output
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/

# Build output
dist/
build/
out/
.output/

# Logs
*.log
logs/
*.log.*

# Operating system
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# Local agent/editor settings
.claude/settings.local.json
.vscode/settings.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*.tmp
*.bak
*.orig

# Keep VS Code MCP configuration when present
!.vscode/mcp.json

# Certificates and private keys
*.pem
*.key
*.cert
*.p12
*.pfx

# Playwright reports/cache
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Python environments/cache
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/

# Temporary/cache files
.cache/
.temp/
.tmp/
*.tmp
